const pt = k => PF_T[LANG][k];
const L2 = (o,b) => LANG==="es" ? o[b+"_es"] : o[b+"_en"];
let caseIdx = 0, reelFilter = "all";

/* ---------- count-up ---------- */
function countUp(el){
  const raw = el.dataset.v; const m = raw.match(/(\d+(?:[.,]\d+)?)/);
  if(!m || raw.includes("→")){ el.textContent = raw; return; }
  const numStr = m[1], sep = numStr.includes(",") ? "," : (numStr.includes(".") ? "." : "");
  const dec = sep ? numStr.split(sep)[1].length : 0, target = parseFloat(numStr.replace(",", "."));
  const pre = raw.slice(0, m.index), post = raw.slice(m.index + numStr.length);
  const t0 = performance.now(), dur = 1300;
  (function tick(t){
    const p = Math.min(1,(t-t0)/dur), e = 1-Math.pow(1-p,3);
    let v = (target*e).toFixed(dec); if(sep) v = v.replace(".", sep);
    el.textContent = pre + v + post;
    if(p<1) requestAnimationFrame(tick); else el.textContent = raw;
  })(t0);
}

/* ---------- logos ---------- */
function renderLogos(){
  document.getElementById("logoWall").innerHTML = CLIENTS.map(c=>
    `<div class="lw ${c.tall?'tall':''} ${c.c?'case':''}" ${c.c?`data-case="${c.c}" title="${c.n}"`:`title="${c.n}"`}>
       <img src="${IMG[c.k]}" alt="${c.n}" loading="lazy"><span class="lw-n">${c.n}</span></div>`).join("");
  document.getElementById("brandCount").textContent = CLIENTS.length + 1; // + Sergio Peinado
  document.querySelectorAll(".lw.case").forEach(el=>el.addEventListener("click",()=>{
    caseIdx = CASES.findIndex(c=>c.id===el.dataset.case); renderCase(true);
    document.getElementById("cases").scrollIntoView({behavior:"smooth",block:"start"});
  }));
}

/* ---------- cases ---------- */
function renderTabs(){
  document.getElementById("caseTabs").innerHTML = CASES.map((c,i)=>
    `<button class="ctab ${i===caseIdx?'on':''}" data-i="${i}" role="tab">
       <span class="cl ${c.logo?'':'mono'}">${c.logo?`<img src="${IMG[c.logo]}" alt="">`:c.mono}</span>${c.tab}</button>`).join("");
  document.querySelectorAll(".ctab").forEach(b=>b.addEventListener("click",()=>{caseIdx=+b.dataset.i;renderCase(true);}));
}
function renderCase(scrollTab){
  const c = CASES[caseIdx], st = document.getElementById("caseStage");
  document.querySelectorAll(".ctab").forEach((b,i)=>b.classList.toggle("on",i===caseIdx));
  if(scrollTab){ const on=document.querySelector(".ctab.on"); on && on.scrollIntoView({behavior:"smooth",inline:"center",block:"nearest"}); }
  st.classList.toggle("wide", !!c.poster);
  const chips = (c.chips||[]).map((ch,i)=>`<div class="float-chip c${i+1}"><div class="n grad-text">${ch[0]}</div><div class="l">${LANG==="es"?ch[1]:ch[2]}</div></div>`).join("");
  const seal = `<div class="award-seal"><svg viewBox="0 0 118 118"><defs><path id="sealp" d="M59,59 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
      <text font-family="Space Grotesk" font-weight="700" font-size="10.2" letter-spacing="1.6" fill="#E01474"><textPath href="#sealp">${pt("seal")}</textPath></text></svg>
      <img src="${IMG.saludfestival}" alt="Salud Festival"></div>`;
  const media = c.poster
    ? `<div style="position:relative;width:100%">${seal}<div class="vframe" data-video="${c.video}"><img src="${IMG[c.poster]}" alt="${c.title}"><div class="vshade"></div><div class="play"></div><div class="vtag">▶ ${pt("play")}</div></div></div>`
    : `${chips}<div class="phone" id="phone"><div class="screen"><img src="${IMG[c.shot]}" alt="${c.title}"><div class="shine"></div></div></div><div class="media-hint">${pt("hover")}</div>`;
  const kpis = c.kpis.map(k=>`<div class="kpi"><div class="kv" data-v="${k[0]}">${k[0]}</div><div class="kl">${LANG==="es"?k[1]:k[2]}</div></div>`).join("");
  st.innerHTML = `<span class="glow"></span>
    <div class="case-media case-anim">${media}</div>
    <div class="case-info case-anim d2">
      <div class="case-top"><span class="handle">◎ ${c.handle}</span><span class="sector">${L2(c,"sector")}</span><span class="period">${LANG==="es"?c.period:c.period_en}</span></div>
      <h3>${c.title}</h3><span class="crole">${L2(c,"role")}</span>
      <p class="cdesc">${LANG==="es"?c.es:c.en}</p>
      <ul>${(LANG==="es"?c.li_es:c.li_en).map(l=>`<li>${l}</li>`).join("")}</ul>
      <div class="kpis">${kpis}</div>
      ${c.award_es?`<div class="case-award">🏆 ${L2(c,"award")}</div>`:""}
      <div class="case-actions">
        <a class="btn btn-ghost" href="${c.url}" target="_blank" rel="noopener">${pt("see")}</a>
        <div class="case-nav"><span class="idx">${String(caseIdx+1).padStart(2,"0")} / ${String(CASES.length).padStart(2,"0")}</span>
          <button class="arrow" data-d="-1" aria-label="Anterior">←</button><button class="arrow" data-d="1" aria-label="Siguiente">→</button></div>
      </div>
    </div>
    ${c.reels?`<div class="case-reels case-anim d2">
      <div class="cr-head"><h4><span>${pt("cr_k")}</span>${pt("cr_h")}</h4><div class="cr-badge"><b>${c.reels.length}</b> ${pt("cr_b")}</div></div>
      <div class="cr-grid">${c.reels.map((u,i)=>`<div class="igc" data-u="${u}" tabindex="0" aria-label="${pt("cr_t")} ${i+1}">
        <div class="ig-top"><span class="ig-views">▶ 1M+</span><span class="ig-n">#${i+1}</span></div><div class="play"></div>
        <div class="ig-bot"><span>${pt("cr_r")}</span><span>${pt("cr_tap")} ↗</span></div></div>`).join("")}</div></div>`:""}`;
  st.querySelectorAll(".igc").forEach(card=>{
    const open=()=>openLB({client:"Sergio Peinado",t_es:PF_T.es.cr_t,t_en:PF_T.en.cr_t,r_es:PF_T.es.cr_r,r_en:PF_T.en.cr_r,d_es:PF_T.es.cr_d,d_en:PF_T.en.cr_d,video:card.dataset.u,url:card.dataset.u,
      kpis:[["1M+","Visualizaciones","Views"],["100%","Guion + edición","Script + editing"]]});
    card.addEventListener("click",open); card.addEventListener("keydown",e=>{if(e.key==="Enter")open();});
  });
  sizeReels(); loadReels();
  st.querySelectorAll(".case-nav .arrow").forEach(a=>a.addEventListener("click",()=>{caseIdx=(caseIdx+ +a.dataset.d+CASES.length)%CASES.length;renderCase(true);}));
  const vf = st.querySelector(".vframe"); if(vf) vf.addEventListener("click",()=>openLB(VIDEOS.find(v=>v.id===vf.dataset.video)));
  const ph = st.querySelector("#phone");
  if(ph && matchMedia("(hover:hover)").matches){
    ph.parentElement.addEventListener("mousemove",e=>{const r=ph.getBoundingClientRect();const x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;ph.style.transform=`rotateY(${x*14}deg) rotateX(${-y*10}deg)`;});
    ph.parentElement.addEventListener("mouseleave",()=>ph.style.transform="");
  }
  if(stageSeen) st.querySelectorAll(".kv").forEach(countUp);
}
let stageSeen = false;
new IntersectionObserver((es,o)=>es.forEach(e=>{ if(e.isIntersecting){ stageSeen=true; e.target.querySelectorAll(".kv").forEach(countUp); o.disconnect(); } }),{threshold:.35})
  .observe(document.getElementById("caseStage"));

/* ---------- reel ---------- */
function renderReel(){
  const cats = ["all","campaign","ugc"];
  document.getElementById("reelFilters").innerHTML = cats.map(c=>`<button class="rf ${c===reelFilter?'on':''}" data-f="${c}">${pt("f_"+c)}</button>`).join("");
  document.querySelectorAll(".rf").forEach(b=>b.addEventListener("click",()=>{reelFilter=b.dataset.f;renderReel();document.getElementById("reelTrack").scrollTo({left:0,behavior:"smooth"});}));
  document.getElementById("reelTrack").innerHTML = VIDEOS.map(v=>
    `<article class="vcard ${v.h?'h':''} ${reelFilter!=="all"&&v.cat!==reelFilter?'hide':''}" data-id="${v.id}" tabindex="0">
       <img src="${IMG[v.poster]}" alt="${L2(v,"t")}" loading="lazy">
       <div class="vc-top"><span class="vc-client">${v.client}</span><span class="vc-fmt">${v.h?"16:9":"9:16"}</span></div>
       <div class="play"></div>
       <div class="vc-bot"><h4>${L2(v,"t")}</h4><div class="vr">${L2(v,"r")}</div><span class="vm">${v.m}</span></div>
     </article>`).join("");
  document.querySelectorAll(".vcard").forEach(c=>{
    const open=()=>openLB(VIDEOS.find(v=>v.id===c.dataset.id));
    c.addEventListener("click",open); c.addEventListener("keydown",e=>{if(e.key==="Enter")open();});
  });
  updateProg();
}
const track = document.getElementById("reelTrack");
function updateProg(){ const max=track.scrollWidth-track.clientWidth; const vis=track.clientWidth/track.scrollWidth;
  const bar=document.getElementById("reelProg"); bar.style.width=Math.max(vis*100,12)+"%"; bar.style.marginLeft=(max>0?track.scrollLeft/max*(100-Math.max(vis*100,12)):0)+"%"; }
track.addEventListener("scroll",updateProg,{passive:true}); addEventListener("resize",updateProg);
document.getElementById("reelPrev").onclick=()=>track.scrollBy({left:-320,behavior:"smooth"});
document.getElementById("reelNext").onclick=()=>track.scrollBy({left:320,behavior:"smooth"});
/* drag-to-scroll en desktop */
(function(){let down=false,sx=0,sl=0,moved=false;
  track.addEventListener("mousedown",e=>{down=true;moved=false;sx=e.pageX;sl=track.scrollLeft;track.style.scrollSnapType="none";});
  addEventListener("mouseup",()=>{if(down){down=false;track.style.scrollSnapType="";}});
  track.addEventListener("mousemove",e=>{if(!down)return;const dx=e.pageX-sx;if(Math.abs(dx)>5)moved=true;track.scrollLeft=sl-dx;});
  track.addEventListener("click",e=>{if(moved){e.stopPropagation();e.preventDefault();moved=false;}},true);
})();

/* ---------- lightbox ---------- */
function embedFor(u){
  if(!u) return "";
  let m;
  if(/\.mp4($|\?)/i.test(u)) return `<video src="${u}" controls autoplay playsinline></video>`;
  if(m=u.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([\w-]{11})/)) return `<iframe src="https://www.youtube.com/embed/${m[1]}?autoplay=1&rel=0" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>`;
  if(m=u.match(/instagram\.com\/(?:[\w.]+\/)?(reel|p|tv)\/([\w-]+)/)) return `<iframe src="https://www.instagram.com/${m[1]}/${m[2]}/embed/" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>`;
  if(m=u.match(/tiktok\.com\/.*video\/(\d+)/)) return `<iframe src="https://www.tiktok.com/embed/v2/${m[1]}" allowfullscreen></iframe>`;
  return "";
}
const lb=document.getElementById("lb");
function openLB(v){
  if(!v) return;
  const emb = embedFor(v.video), media=document.getElementById("lbMedia");
  media.className = "lb-media" + (/instagram/.test(emb) ? " ig" : (v.h ? " h" : ""));
  media.innerHTML = emb || `<img src="${IMG[v.poster]}" alt=""><div class="soon">▶ ${pt("soon")}</div>`;
  const kp = (v.kpis||[]).map(k=>`<div class="kpi"><div class="kv">${k[0]}</div><div class="kl">${LANG==="es"?k[1]:k[2]}</div></div>`).join("");
  document.getElementById("lbInfo").innerHTML = `<span class="vc-client">${v.client}</span><h3>${L2(v,"t")}</h3>
    <div class="lbr">${L2(v,"r")}</div><p>${L2(v,"d")}</p>${kp?`<div class="kpis">${kp}</div>`:""}
    <a class="btn btn-primary" href="${v.video||v.url}" target="_blank" rel="noopener">${emb?pt("see"):pt("watch")+" ↗"}</a>`;
  lb.classList.add("open"); document.body.style.overflow="hidden";
}
function closeLB(){ lb.classList.remove("open"); document.getElementById("lbMedia").innerHTML=""; document.body.style.overflow=""; }
document.getElementById("lbClose").onclick=closeLB;
lb.addEventListener("click",e=>{if(e.target===lb)closeLB();});
addEventListener("keydown",e=>{
  if(e.key==="Escape") closeLB();
  const st=document.getElementById("caseStage").getBoundingClientRect();
  if(!lb.classList.contains("open") && st.top<innerHeight*.6 && st.bottom>innerHeight*.4 && (e.key==="ArrowRight"||e.key==="ArrowLeft")){
    caseIdx=(caseIdx+(e.key==="ArrowRight"?1:-1)+CASES.length)%CASES.length; renderCase(true);
  }
});

/* reels de Instagram: el embed muestra el vídeo en 4:5 bajo una cabecera de 54px;
   lo ampliamos para que llene una tarjeta 9:16 y ocultamos cabecera y pie */
function sizeReels(){
  document.querySelectorAll(".igc").forEach(c=>{
    const W=c.clientWidth,H=c.clientHeight,f=c.querySelector("iframe"); if(!f||!W) return;
    const wi=Math.ceil(H/1.25)+2; f.style.width=wi+"px"; f.style.left=(-(wi-W)/2)+"px"; f.style.height=(H+54+260)+"px";
  });
}
let reelIO;
function loadReels(){
  if(reelIO) reelIO.disconnect();
  reelIO=new IntersectionObserver(es=>es.forEach(e=>{
    if(!e.isIntersecting) return; const c=e.target; reelIO.unobserve(c);
    const m=c.dataset.u.match(/\/(reel|p)\/([\w-]+)/); if(!m) return;
    const f=document.createElement("iframe"); f.src=`https://www.instagram.com/${m[1]}/${m[2]}/embed/`; f.loading="lazy"; f.scrolling="no"; f.tabIndex=-1; f.title="Instagram reel";
    f.onload=()=>c.style.animation="none"; c.prepend(f); sizeReels();
  }),{rootMargin:"200px"});
  document.querySelectorAll(".igc").forEach(c=>reelIO.observe(c));
}
addEventListener("resize",sizeReels);

function renderPortfolio(){ renderLogos(); renderTabs(); renderCase(false); renderReel(); }

function renderAll(){
  renderChrome();renderMarquee();renderStats();renderTimeline();
  renderPortfolio();renderSkills();renderEdu();renderSeek();
  observeReveals();
}

/* reveal on scroll */
let io;
function observeReveals(){
  if(io) io.disconnect();
  io = new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);}}),{threshold:.12});
  document.querySelectorAll(".reveal").forEach(el=>io.observe(el));
}

/* lang toggle */
document.querySelectorAll(".lang button").forEach(b=>{
  b.addEventListener("click",()=>{
    LANG = b.dataset.lang;
    document.querySelectorAll(".lang button").forEach(x=>x.classList.toggle("on",x===b));
    renderAll();
  });
});

/* mobile menu */
const nt=document.getElementById("navToggle"), nl=document.getElementById("navLinks");
nt.addEventListener("click",()=>nl.classList.toggle("open"));
nl.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>nl.classList.remove("open")));

renderAll();

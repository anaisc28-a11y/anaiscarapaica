/* ============ RENDER ============ */
let LANG = "es";

function renderChrome(){
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const k = el.getAttribute("data-i18n");
    if(T[LANG][k]!==undefined) el.innerHTML = T[LANG][k];
  });
  document.documentElement.lang = LANG;
}

function renderMarquee(){
  const items = MARQUEE[LANG];
  let html="";
  const build = ()=> items.map(i=>`<span>${i}</span><b class="star">✦</b>`).join("");
  document.getElementById("mq").innerHTML = build()+build();
}

function renderStats(){
  document.getElementById("statGrid").innerHTML = STATS.map(s=>`
    <div class="stat reveal"><div class="sn">${s.n}</div><div class="sl">${s[LANG]}</div><div class="st">${s.t}</div></div>`).join("");
}

function renderTimeline(){
  document.getElementById("timeline").innerHTML = JOBS.map(j=>{
    const when = LANG==="es"?j.when:j.when_en;
    const role = LANG==="es"?j.role:j.role_en;
    const bullets = (LANG==="es"?j.es:j.en).map(b=>`<li>${b}</li>`).join("");
    const tags = (LANG==="es"?j.tags:j.tags_en).map(t=>`<b>${t}</b>`).join("");
    return `<div class="job reveal"><span class="node"></span>
      <div class="when">${when}</div>
      <h3>${role}</h3>
      <div class="co"><b>${j.co}</b> <span class="place">· ${j.place}</span></div>
      <ul>${bullets}</ul>
      <div class="tags">${tags}</div>
    </div>`;
  }).join("");
}

function renderProjects(){
  document.getElementById("projGrid").innerHTML = PROJECTS.map(p=>{
    const desc = LANG==="es"?p.es:p.en;
    const role = LANG==="es"?p.role_es:p.role_en;
    const metrics = p.metrics.map(m=>`<div class="metric"><div class="mv">${m.v}</div><div class="mk">${m[LANG]}</div></div>`).join("");
    const award = p.award_es?`<div class="award">🏆 ${LANG==="es"?p.award_es:p.award_en}</div>`:"";
    return `<div class="card ${p.feat?'feat':''} reveal">
      <span class="handle">◎ ${p.handle}</span>
      <div class="role-badge">${role}</div>
      <h3>${p.title}</h3>
      <p class="desc">${desc}</p>
      <div class="metrics">${metrics}</div>${award}
    </div>`;
  }).join("");
  document.getElementById("brandRow").innerHTML = BRANDS.map(b=>`<b>${b}</b>`).join("");
}

function renderSkills(){
  document.getElementById("skillGrid").innerHTML = SKILLS.map(s=>{
    const tags = s.tags.map(t=>{
      const label = t.length===3 ? (LANG==="es"?t[0]:t[1]) : t[0];
      const key = t.length===3 ? t[2] : t[1];
      return `<b class="${key?'k':''}">${label}</b>`;
    }).join("");
    return `<div class="skill-cat reveal">
      <div class="sc-top"><div class="ic">${s.ic}</div><h3>${LANG==="es"?s.es:s.en}</h3></div>
      <div class="tags">${tags}</div>
    </div>`;
  }).join("");
}

function renderEdu(){
  document.getElementById("eduList").innerHTML = EDU.map(e=>`
    <div class="edu reveal">
      <div class="yr">${e.yr}</div>
      <div class="et"><h3>${LANG==="es"?e.es:e.en}</h3><p>${e.where}</p></div>
      ${e.badge?`<div class="badge">${e.badge}</div>`:""}
    </div>`).join("");
}

function renderSeek(){
  document.getElementById("seekGrid").innerHTML = SEEK.map(s=>`
    <div class="seek-card reveal">
      <div class="num">${LANG==="es"?s.num:s.num_en}</div>
      <h3>${LANG==="es"?s.t:s.t_en}</h3>
      <p>${LANG==="es"?s.es:s.en}</p>
    </div>`).join("");
}



Object.assign(T.en,{nav_proj:"Portfolio",nav_vid:"Videos",hero_cta2:"See portfolio ↓",proj_h:"Real work. Real results.",
  proj_p:"The brands I've worked with, the cases I've led — with their numbers — and the videos that tell them best.",
  pf_clients_k:"01 · Clients",pf_clients_h:"Brands that trusted me",pf_clients_n:"brands · creators · institutions",

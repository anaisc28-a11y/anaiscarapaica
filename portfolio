<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Anais Carapaica — Brand & Social Media Manager</title>
<meta name="description" content="Anais Carapaica — Brand & Social Media Manager. 9 años liderando estrategia, equipos y paid media para marcas de gran consumo y creadores de 1.6MM+.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#141110;
  --bg:#FAF6F0;
  --cream:#FFFDF9;
  --magenta:#E01474;
  --magenta-2:#FF2E88;
  --orange:#FF5A1F;
  --orange-2:#FF7A3C;
  --green:#1C6B4C;
  --violet:#7A2FF2;
  --muted:#6b6157;
  --line:rgba(20,17,16,.12);
  --grad:linear-gradient(100deg,var(--magenta) 0%,var(--orange) 100%);
  --grad-soft:linear-gradient(120deg,#FF2E88 0%,#FF5A1F 60%,#FF9A3C 100%);
  --shadow:0 24px 60px -20px rgba(224,20,116,.35);
  --r:22px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Sora',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  background:var(--bg);color:var(--ink);line-height:1.55;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
h1,h2,h3,.display{font-family:'Space Grotesk','Sora',sans-serif;line-height:1.02;letter-spacing:-.02em}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
.grad-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}

/* NAV */
header.nav{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);background:rgba(250,246,240,.78);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font-family:'Space Grotesk';font-weight:700;font-size:19px;letter-spacing:-.02em;display:flex;align-items:center;gap:9px}
.logo .dot{width:11px;height:11px;border-radius:50%;background:var(--grad)}
.nav-links{display:flex;gap:26px;align-items:center}
.nav-links a{font-size:14.5px;font-weight:500;color:var(--muted);transition:color .2s}
.nav-links a:hover{color:var(--ink)}
.nav-right{display:flex;align-items:center;gap:14px}
.lang{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;font-family:'Space Grotesk';font-weight:600;font-size:13px}
.lang button{background:none;border:0;padding:7px 13px;cursor:pointer;color:var(--muted);transition:.2s}
.lang button.on{background:var(--ink);color:#fff}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:999px;font-weight:600;font-size:14.5px;font-family:'Space Grotesk';cursor:pointer;transition:transform .18s ease, box-shadow .2s;border:0}
.btn-primary{background:var(--grad);color:#fff;box-shadow:var(--shadow)}
.btn-primary:hover{transform:translateY(-2px)}
.btn-ghost{background:transparent;border:1.5px solid var(--ink);color:var(--ink)}
.btn-ghost:hover{background:var(--ink);color:#fff}
.nav-toggle{display:none;background:none;border:0;cursor:pointer}

/* HERO */
.hero{position:relative;padding:64px 0 40px;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:52px;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:9px;font-family:'Space Grotesk';font-weight:600;font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--magenta);margin-bottom:22px}
.eyebrow::before{content:"";width:28px;height:2px;background:var(--grad)}
.hero h1{font-size:clamp(38px,6vw,68px);font-weight:700;margin-bottom:22px}
.hero h1 em{font-style:normal}
.hero-sub{font-size:clamp(16px,1.7vw,19px);color:var(--muted);max-width:520px;margin-bottom:26px}
.role-chips{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:30px}
.chip{padding:8px 15px;border-radius:999px;background:var(--cream);border:1px solid var(--line);font-size:13.5px;font-weight:600;font-family:'Space Grotesk'}
.chip.hot{background:var(--grad);color:#fff;border-color:transparent}
.hero-cta{display:flex;flex-wrap:wrap;gap:13px}
.hero-photo{position:relative}
.hero-photo .frame{position:relative;border-radius:26px;overflow:hidden;box-shadow:var(--shadow);transform:rotate(2deg)}
.hero-photo .frame::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(224,20,116,.18))}
.blob{position:absolute;border-radius:50%;filter:blur(38px);opacity:.5;z-index:-1}
.blob.b1{width:280px;height:280px;background:var(--magenta-2);top:-40px;right:-30px}
.blob.b2{width:230px;height:230px;background:var(--orange);bottom:-30px;left:-40px}
.float-stat{position:absolute;background:var(--cream);border:1px solid var(--line);border-radius:16px;padding:12px 15px;box-shadow:0 14px 30px -12px rgba(20,17,16,.25);font-family:'Space Grotesk'}
.float-stat .n{font-weight:700;font-size:21px;line-height:1}
.float-stat .l{font-size:11px;color:var(--muted);font-family:'Sora';font-weight:500}
.float-stat.fs1{top:26px;left:-26px}
.float-stat.fs2{bottom:44px;right:-22px}

/* MARQUEE */
.marquee{background:var(--ink);color:#fff;padding:16px 0;overflow:hidden;white-space:nowrap;margin-top:24px}
.marquee-track{display:inline-flex;gap:46px;animation:scroll 26s linear infinite;font-family:'Space Grotesk';font-weight:600;font-size:16px;align-items:center}
.marquee-track span{opacity:.55}
.marquee-track b{color:var(--orange-2);opacity:1}
.marquee .star{color:var(--magenta-2)}
@keyframes scroll{to{transform:translateX(-50%)}}

/* SECTIONS */
section{padding:84px 0}
.sec-head{max-width:720px;margin-bottom:46px}
.sec-tag{font-family:'Space Grotesk';font-weight:600;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--magenta);margin-bottom:14px;display:block}
.sec-head h2{font-size:clamp(30px,4.4vw,46px);font-weight:700;margin-bottom:16px}
.sec-head p{color:var(--muted);font-size:17px}

/* ABOUT */
.about{background:var(--cream)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:start}
.about-lead{font-size:clamp(19px,2.2vw,24px);font-weight:500;line-height:1.4;margin-bottom:22px}
.about p+p{margin-top:14px;color:var(--muted)}
.now-card{margin-top:26px;border-radius:var(--r);padding:22px 24px;background:var(--grad);color:#fff;box-shadow:var(--shadow)}
.now-card .k{font-family:'Space Grotesk';font-weight:600;font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;opacity:.9;margin-bottom:8px}
.now-card p{color:#fff;opacity:.96;font-size:15.5px}
.traits{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
.trait{padding:9px 16px;border-radius:12px;background:var(--bg);border:1px solid var(--line);font-family:'Space Grotesk';font-weight:600;font-size:14px}
.trait span{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.mini-facts{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:26px}
.mini{border:1px solid var(--line);border-radius:16px;padding:18px;background:var(--bg)}
.mini .mn{font-family:'Space Grotesk';font-weight:700;font-size:30px;line-height:1}
.mini .ml{font-size:13px;color:var(--muted);margin-top:6px}

/* STATS band */
.band{background:var(--ink);color:#fff}
.band .sec-head h2,.band .sec-head p{color:#fff}
.band .sec-tag{color:var(--orange-2)}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.stat{border:1px solid rgba(255,255,255,.14);border-radius:var(--r);padding:26px 22px;position:relative;overflow:hidden;transition:.25s}
.stat:hover{border-color:transparent;background:rgba(255,255,255,.04);transform:translateY(-4px)}
.stat .sn{font-family:'Space Grotesk';font-weight:700;font-size:clamp(30px,3.4vw,40px);line-height:1;background:var(--grad-soft);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.stat .sl{margin-top:12px;font-size:14px;color:rgba(255,255,255,.72);line-height:1.4}
.stat .st{margin-top:4px;font-size:12px;color:rgba(255,255,255,.45);font-family:'Space Grotesk';font-weight:500}

/* TIMELINE */
.tl{position:relative;margin-top:10px}
.tl::before{content:"";position:absolute;left:14px;top:6px;bottom:6px;width:2px;background:linear-gradient(var(--magenta),var(--orange))}
.job{position:relative;padding:0 0 40px 52px}
.job:last-child{padding-bottom:0}
.job .node{position:absolute;left:6px;top:4px;width:18px;height:18px;border-radius:50%;background:var(--grad);box-shadow:0 0 0 5px var(--bg)}
.job .when{font-family:'Space Grotesk';font-weight:600;font-size:13px;color:var(--magenta);letter-spacing:.03em}
.job h3{font-size:22px;font-weight:700;margin:6px 0 3px}
.job .co{font-weight:600;color:var(--ink);font-size:15px;margin-bottom:2px}
.job .co b{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.job .co .place{color:var(--muted);font-weight:500}
.job ul{list-style:none;margin-top:12px;display:grid;gap:7px}
.job ul li{position:relative;padding-left:20px;font-size:14.5px;color:var(--muted)}
.job ul li::before{content:"";position:absolute;left:2px;top:9px;width:7px;height:7px;border-radius:2px;background:var(--grad)}
.job .tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
.job .tags b{font-family:'Space Grotesk';font-weight:600;font-size:12px;padding:5px 11px;border-radius:999px;background:var(--cream);border:1px solid var(--line);color:var(--ink)}

/* PROJECTS */
.proj{background:var(--cream)}
.proj-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
.card{border:1px solid var(--line);border-radius:var(--r);padding:26px;background:var(--bg);transition:.25s;position:relative;overflow:hidden}
.card:hover{transform:translateY(-5px);box-shadow:var(--shadow);border-color:transparent}
.card.feat{grid-column:span 2;background:var(--ink);color:#fff;border-color:transparent}
.card .handle{font-family:'Space Grotesk';font-weight:600;font-size:13px;color:var(--magenta);margin-bottom:9px;display:inline-flex;align-items:center;gap:6px}
.card.feat .handle{color:var(--orange-2)}
.card h3{font-size:22px;font-weight:700;margin-bottom:8px}
.card .role-badge{display:inline-block;font-family:'Space Grotesk';font-weight:600;font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:999px;background:var(--grad);color:#fff;margin-bottom:12px}
.card p.desc{font-size:14.5px;color:var(--muted);margin-bottom:18px}
.card.feat p.desc{color:rgba(255,255,255,.72)}
.metrics{display:flex;flex-wrap:wrap;gap:20px}
.metric .mv{font-family:'Space Grotesk';font-weight:700;font-size:26px;line-height:1;background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.card.feat .metric .mv{background:var(--grad-soft);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.metric .mk{font-size:12px;color:var(--muted);margin-top:5px}
.card.feat .metric .mk{color:rgba(255,255,255,.6)}
.award{margin-top:16px;display:inline-flex;align-items:center;gap:8px;font-family:'Space Grotesk';font-weight:600;font-size:13px;padding:7px 13px;border-radius:999px;background:rgba(255,90,31,.14);color:var(--orange)}
.other-brands{margin-top:26px;border:1px dashed var(--line);border-radius:var(--r);padding:22px 24px}
.other-brands .obh{font-family:'Space Grotesk';font-weight:600;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.brand-row{display:flex;flex-wrap:wrap;gap:9px}
.brand-row b{font-family:'Space Grotesk';font-weight:600;font-size:13.5px;padding:7px 14px;border-radius:10px;background:var(--cream);border:1px solid var(--line)}

/* SKILLS */
.skill-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.skill-cat{border:1px solid var(--line);border-radius:var(--r);padding:26px;background:var(--cream)}
.skill-cat .sc-top{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.skill-cat .ic{width:42px;height:42px;border-radius:12px;background:var(--grad);display:grid;place-items:center;color:#fff;font-family:'Space Grotesk';font-weight:700;font-size:19px;flex:none}
.skill-cat h3{font-size:18px;font-weight:700}
.skill-cat .tags{display:flex;flex-wrap:wrap;gap:8px}
.skill-cat .tags b{font-weight:500;font-family:'Sora';font-size:13.5px;padding:7px 13px;border-radius:999px;background:var(--bg);border:1px solid var(--line)}
.skill-cat .tags b.k{background:var(--grad);color:#fff;border-color:transparent;font-weight:600}

/* EDU + LANG */
.edu-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:40px}
.edu-list{display:grid;gap:14px}
.edu{display:flex;gap:16px;padding:18px 20px;border:1px solid var(--line);border-radius:16px;background:var(--cream);transition:.2s}
.edu:hover{border-color:var(--magenta)}
.edu .yr{font-family:'Space Grotesk';font-weight:700;font-size:14px;color:var(--magenta);flex:none;min-width:70px}
.edu .et h3{font-size:16px;font-weight:600}
.edu .et p{font-size:13.5px;color:var(--muted)}
.edu .badge{margin-left:auto;font-family:'Space Grotesk';font-weight:600;font-size:11px;padding:4px 9px;border-radius:8px;background:var(--grad);color:#fff;align-self:center;flex:none}
.lang-block{border:1px solid var(--line);border-radius:var(--r);padding:26px;background:var(--cream);height:fit-content}
.lang-block h3{font-size:16px;font-weight:700;margin-bottom:18px}
.lg{margin-bottom:18px}
.lg .lgt{display:flex;justify-content:space-between;font-weight:600;font-size:14.5px;margin-bottom:8px}
.lg .lgt span{color:var(--muted);font-weight:500;font-size:13px}
.bar{height:9px;border-radius:999px;background:var(--bg);overflow:hidden}
.bar i{display:block;height:100%;border-radius:999px;background:var(--grad)}
.cert-mini{margin-top:8px;font-size:13px;color:var(--muted)}
.cert-mini b{color:var(--ink)}
.cert-list{display:grid;gap:14px}
.cert-item{display:flex;flex-direction:column;gap:3px;padding-left:16px;position:relative}
.cert-item::before{content:"";position:absolute;left:0;top:7px;width:8px;height:8px;border-radius:2px;background:var(--grad)}
.cert-item b{font-size:15px;font-weight:600}
.cert-item span{font-size:13px;color:var(--muted)}
.cert-note{margin-top:16px;font-size:13.5px;color:var(--muted);line-height:1.5}
.cert-note b{color:var(--ink)}
.idiomas-line{margin-top:16px;padding-top:16px;border-top:1px solid var(--line);font-size:14px;color:var(--muted)}
.idiomas-line b{color:var(--ink);font-family:'Space Grotesk';font-weight:600}

/* ROLES / seeking */
.seek{background:var(--ink);color:#fff}
.seek .sec-head h2{color:#fff}
.seek .sec-tag{color:var(--orange-2)}
.seek-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.seek-card{border:1px solid rgba(255,255,255,.14);border-radius:var(--r);padding:28px 24px;transition:.25s}
.seek-card:hover{transform:translateY(-5px);background:rgba(255,255,255,.04)}
.seek-card .num{font-family:'Space Grotesk';font-weight:700;font-size:15px;color:var(--orange-2);margin-bottom:14px}
.seek-card h3{font-size:20px;font-weight:700;margin-bottom:10px}
.seek-card p{font-size:14px;color:rgba(255,255,255,.7)}

/* CONTACT */
.contact{background:var(--grad);color:#fff;text-align:center}
.contact h2{font-size:clamp(32px,5vw,54px);font-weight:700;margin-bottom:18px;color:#fff}
.contact p.lead{font-size:18px;opacity:.95;max-width:560px;margin:0 auto 34px}
.contact-links{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-bottom:34px}
.clink{display:inline-flex;align-items:center;gap:9px;padding:13px 22px;border-radius:999px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);font-family:'Space Grotesk';font-weight:600;font-size:15px;color:#fff;transition:.2s}
.clink:hover{background:#fff;color:var(--magenta)}
.clink.solid{background:#fff;color:var(--magenta)}
.contact .loc{font-family:'Space Grotesk';font-weight:500;opacity:.9;font-size:14.5px}

footer{background:var(--ink);color:rgba(255,255,255,.6);padding:34px 0;font-size:13.5px}
.foot-in{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.foot-in .logo{color:#fff}

.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease, transform .7s ease}
.reveal.in{opacity:1;transform:none}

@media(max-width:900px){
  .hero-grid{grid-template-columns:1fr;gap:40px}
  .hero-photo{max-width:400px;margin:0 auto}
  .about-grid,.edu-grid{grid-template-columns:1fr;gap:32px}
  .stat-grid{grid-template-columns:repeat(2,1fr)}
  .proj-grid,.skill-grid,.seek-grid{grid-template-columns:1fr}
  .card.feat{grid-column:span 1}
  .nav-links{display:none}
  .nav-links.open{display:flex;position:absolute;top:68px;left:0;right:0;flex-direction:column;background:var(--cream);padding:20px 24px;border-bottom:1px solid var(--line);gap:16px}
  .nav-toggle{display:block}
  .float-stat{display:none}
}
@media(max-width:520px){
  .stat-grid,.mini-facts{grid-template-columns:1fr}
  .hero h1{font-size:40px}
  section{padding:64px 0}
}

/* ================= PORTFOLIO VISUAL ================= */
.pf{background:var(--cream);position:relative;overflow:hidden}
.pf::before{content:"";position:absolute;width:520px;height:520px;border-radius:50%;background:var(--magenta-2);filter:blur(120px);opacity:.12;top:-160px;right:-180px;pointer-events:none}
.pf-sub{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 22px;flex-wrap:wrap}
.pf-sub h3{font-size:clamp(22px,2.6vw,28px);font-weight:700}
.pf-sub .pf-kicker{font-family:'Space Grotesk';font-weight:600;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;display:block}
.pf-count{font-family:'Space Grotesk';font-weight:600;font-size:13.5px;color:var(--muted)}
.pf-count b{font-size:22px;margin-right:4px}

/* --- logo wall --- */
.logo-wall{display:grid;grid-template-columns:repeat(8,1fr);gap:12px;margin-bottom:86px}
.lw{aspect-ratio:3/2;border-radius:18px;background:var(--bg);border:1px solid var(--line);display:grid;place-items:center;padding:14px 18px;position:relative;overflow:hidden;transition:transform .3s, box-shadow .3s, border-color .3s}
.lw img{max-width:100%;max-height:42px;object-fit:contain;filter:grayscale(1) contrast(1.1);opacity:.62;transition:filter .35s, opacity .35s, transform .35s}
.lw.tall img{max-height:56px}
.lw .lw-n{position:absolute;left:0;right:0;bottom:7px;text-align:center;font-family:'Space Grotesk';font-size:10.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);opacity:0;transform:translateY(6px);transition:.3s}
.lw:hover{transform:translateY(-4px);box-shadow:0 18px 38px -18px rgba(224,20,116,.45);border-color:transparent}
.lw:hover img{filter:none;opacity:1;transform:translateY(-6px) scale(1.04)}
.lw:hover .lw-n{opacity:1;transform:none}
.lw.case::after{content:"CASO";position:absolute;top:8px;right:8px;font-family:'Space Grotesk';font-size:9px;font-weight:700;letter-spacing:.08em;padding:3px 7px;border-radius:999px;background:var(--grad);color:#fff}
.lw.case{cursor:pointer}

/* --- case explorer --- */
.case-tabs{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 14px;margin-bottom:18px;scrollbar-width:none}
.case-tabs::-webkit-scrollbar{display:none}
.ctab{flex:none;display:inline-flex;align-items:center;gap:9px;padding:9px 16px 9px 10px;border-radius:999px;border:1px solid var(--line);background:var(--bg);font-family:'Space Grotesk';font-weight:600;font-size:14px;color:var(--muted);cursor:pointer;transition:.25s}
.ctab .cl{width:28px;height:28px;border-radius:50%;background:#fff;display:grid;place-items:center;overflow:hidden;border:1px solid var(--line);flex:none}
.ctab .cl img{max-width:22px;max-height:22px;object-fit:contain}
.ctab .cl.mono{background:var(--ink);color:#fff;font-size:11px;border:0}
.ctab:hover{color:var(--ink);border-color:var(--ink)}
.ctab.on{background:var(--ink);color:#fff;border-color:var(--ink);box-shadow:0 12px 26px -14px rgba(20,17,16,.6)}

.case-stage{position:relative;border-radius:30px;background:var(--bg);border:1px solid var(--line);padding:44px;display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:center;min-height:620px;overflow:hidden;margin-bottom:96px}
